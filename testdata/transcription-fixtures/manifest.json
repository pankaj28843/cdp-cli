{
  "schema_version": "cdp-cli-transcription-fixtures/v2",
  "count": 100,
  "engine": "say",
  "voice": "Samantha",
  "entries": [
    {
      "id": "fixture-001",
      "text": "Could you open the latest project notes before the meeting starts?",
      "webm": "001.webm",
      "webm_bytes": 14369,
      "webm_sha256": "7fa6c2377e5b1ada003cfe772ad54b4ddd76646dbbad50a0a4c0537dc1b9a88b"
    },
    {
      "id": "fixture-002",
      "text": "Please remind me to review the deployment checklist this afternoon.",
      "webm": "002.webm",
      "webm_bytes": 14935,
      "webm_sha256": "be8edb7b802c18b353f265f3d79364c7ab119ff586c330cc89c3d6e7943c762c"
    },
    {
      "id": "fixture-003",
      "text": "The small orange notebook is beside the keyboard on my desk.",
      "webm": "003.webm",
      "webm_bytes": 13913,
      "webm_sha256": "755c174e5667223bdb72a9b51c19ce9ab4e28209ead961266594c79319bf3adc"
    },
    {
      "id": "fixture-004",
      "text": "Which route is fastest when the bridge is closed for maintenance?",
      "webm": "004.webm",
      "webm_bytes": 13565,
      "webm_sha256": "17b64bbef5c16b8143ba9e9db18ca2fa1da9bbffc5271c3e9acf873d131ebf76"
    },
    {
      "id": "fixture-005",
      "text": "I would like a quiet room with reliable internet and natural light.",
      "webm": "005.webm",
      "webm_bytes": 14558,
      "webm_sha256": "d57512960e7fdbbd24fc7d915865041cb2b2ed547bbafab25b320551b3ebc728"
    },
    {
      "id": "fixture-006",
      "text": "Can you move the dollar key closer to the beginning of the row?",
      "webm": "006.webm",
      "webm_bytes": 12931,
      "webm_sha256": "0cb369ae762f046bc7c886a109a2721ac4f38ad2ed7e5f1a5a2a5999ead2a4f6"
    },
    {
      "id": "fixture-007",
      "text": "The backup completed successfully, but the report still needs verification.",
      "webm": "007.webm",
      "webm_bytes": 18334,
      "webm_sha256": "be201db27fb83d5937597fe98810a1c99eeabfb37de14b16bb30cd12391b1f65"
    },
    {
      "id": "fixture-008",
      "text": "Let us compare the local result with the remote result before deciding.",
      "webm": "008.webm",
      "webm_bytes": 15790,
      "webm_sha256": "86e5265377879318681e20b04243d1b73267d51a31830292d6454a9a5132cdc8"
    },
    {
      "id": "fixture-009",
      "text": "What time does the train leave from the central station tomorrow morning?",
      "webm": "009.webm",
      "webm_bytes": 15747,
      "webm_sha256": "a9d51c54ad2776f4d4a1e2f69b57ae15abc2d0880e710a53d412c6b63925c2dd"
    },
    {
      "id": "fixture-010",
      "text": "Please save this draft without submitting the form or sending a message.",
      "webm": "010.webm",
      "webm_bytes": 15473,
      "webm_sha256": "c362e56a31afab62a0a476cf01a5e9389af7d888ed3a0c780a0278c1b5d941ca"
    },
    {
      "id": "fixture-011",
      "text": "The new microphone sounds clear even when the room is noisy.",
      "webm": "011.webm",
      "webm_bytes": 13304,
      "webm_sha256": "3c886db3a82fe8ff9d32e113934934bdc6d2c9fc516ca5093db3775ee542a26f"
    },
    {
      "id": "fixture-012",
      "text": "I forgot whether the test server is running on Linux or macOS.",
      "webm": "012.webm",
      "webm_bytes": 15359,
      "webm_sha256": "0f7b0e245b6cb3711acf9a18496860f6e16b352c43a422aa6183755de89f2f3c"
    },
    {
      "id": "fixture-013",
      "text": "Could you explain why the connection was closed after the first request?",
      "webm": "013.webm",
      "webm_bytes": 16485,
      "webm_sha256": "e8808c8f4cd9431e2f439547f3f6d3effc98f6d75526ab58844671eeef45956a"
    },
    {
      "id": "fixture-014",
      "text": "The garden needs water, but the forecast says rain is coming tonight.",
      "webm": "014.webm",
      "webm_bytes": 15044,
      "webm_sha256": "e7bb5aa213efc8a66d499cbc674e6d047e9aaf5dc011e0aba88081979747188b"
    },
    {
      "id": "fixture-015",
      "text": "Please check that every required field has a helpful validation message.",
      "webm": "015.webm",
      "webm_bytes": 16907,
      "webm_sha256": "8b98445d32700272559ee7a4424938507c89745d8c5f32d87a6a27007e005439"
    },
    {
      "id": "fixture-016",
      "text": "The blue folder contains the design references for the next release.",
      "webm": "016.webm",
      "webm_bytes": 15321,
      "webm_sha256": "03967e73c0e35342b977e90047c1b5e6765f8d01dfc1dd641718bb40d2e69017"
    },
    {
      "id": "fixture-017",
      "text": "How many independent providers are ready to accept a transcription request?",
      "webm": "017.webm",
      "webm_bytes": 17964,
      "webm_sha256": "9533b2d94b323abd5333dbd56239d3e2abe6762c432cea9f041ff7731325df35"
    },
    {
      "id": "fixture-018",
      "text": "I want the most frequently used key to remain easy to reach.",
      "webm": "018.webm",
      "webm_bytes": 14305,
      "webm_sha256": "eb3b827b3173766a1c610659f34ba8771e8959e8e8c01818e607440d58c3a77d"
    },
    {
      "id": "fixture-019",
      "text": "The service should recover gracefully when a browser tab disappears.",
      "webm": "019.webm",
      "webm_bytes": 15353,
      "webm_sha256": "5a4ebb5fef3aa8be79a4ba5adbb8ecd9284a36eff384d0fe93f5503a9b79e2f0"
    },
    {
      "id": "fixture-020",
      "text": "Can we keep the interface simple while still exposing advanced settings?",
      "webm": "020.webm",
      "webm_bytes": 16307,
      "webm_sha256": "31a4ec9993b475eb3dde3aeee2221581f7a4d5547a928103bb11b839fc98399c"
    },
    {
      "id": "fixture-021",
      "text": "The invoice total is one hundred twenty four dollars and fifty cents.",
      "webm": "021.webm",
      "webm_bytes": 16534,
      "webm_sha256": "82071ea0fe35c715c015caa1966821ad01c9e2b1a031704832718bbf46196746"
    },
    {
      "id": "fixture-022",
      "text": "Please do not store the audio recording after the transcript is accepted.",
      "webm": "022.webm",
      "webm_bytes": 17253,
      "webm_sha256": "fe627d42f873d79034c29bf3d1a2c60e8cbef6ee37d8d65dc5189d1e6ae16c86"
    },
    {
      "id": "fixture-023",
      "text": "Which device has the newest build installed right now?",
      "webm": "023.webm",
      "webm_bytes": 12228,
      "webm_sha256": "d37389e056418197e72839af2b33bb1aa844e50b46e820003bc276bd171f1480"
    },
    {
      "id": "fixture-024",
      "text": "The child process stopped, so the supervisor should report a clear reason.",
      "webm": "024.webm",
      "webm_bytes": 18482,
      "webm_sha256": "452263cd5d6f213a02bd8e8543ac207791847923a5217b203eee08b786e7ea4e"
    },
    {
      "id": "fixture-025",
      "text": "I need an answer that works on both the laptop and the virtual machine.",
      "webm": "025.webm",
      "webm_bytes": 15326,
      "webm_sha256": "a16b8a8af2ac33774387dac8042364f48462cebd1613b31dde5befea64ae300b"
    },
    {
      "id": "fixture-026",
      "text": "The window is narrow, but the primary action must remain visible.",
      "webm": "026.webm",
      "webm_bytes": 14907,
      "webm_sha256": "fd5dd91b081095f84738ec5458fdea7329d6ed8caf37f30dd4689d29ea95ea8c"
    },
    {
      "id": "fixture-027",
      "text": "Could you sort these favorite keys into the order I use most often?",
      "webm": "027.webm",
      "webm_bytes": 15031,
      "webm_sha256": "999d899540170d52b67427adb7d53141c1045a03574d4caa1d6f68731b2e1f37"
    },
    {
      "id": "fixture-028",
      "text": "The changed host key must block the connection until I approve the replacement.",
      "webm": "028.webm",
      "webm_bytes": 16485,
      "webm_sha256": "91875a04aa4e9ae311ca50296d645f22b13707d5db6aac81d08000a937cf7e0f"
    },
    {
      "id": "fixture-029",
      "text": "A short retry with a bounded timeout is safer than an endless request.",
      "webm": "029.webm",
      "webm_bytes": 16312,
      "webm_sha256": "7fcb96939a0c27c9676b626384471dd3b5e35503d2bddbc1a449db0659b5d3a4"
    },
    {
      "id": "fixture-030",
      "text": "Please write the result in plain language for someone new to the project.",
      "webm": "030.webm",
      "webm_bytes": 15564,
      "webm_sha256": "79508b0c6ccff148d7cd65d569066474967e3fad3ea9c5f30c916dca446898d0"
    },
    {
      "id": "fixture-031",
      "text": "The local model should remain available when the online provider is offline.",
      "webm": "031.webm",
      "webm_bytes": 17283,
      "webm_sha256": "9d680b6b4c8f730abfbe5f84aae6050c81c75521c39e8c31c82f2ec5b732602e"
    },
    {
      "id": "fixture-032",
      "text": "How can we prove that a stale stream never becomes authoritative again?",
      "webm": "032.webm",
      "webm_bytes": 15695,
      "webm_sha256": "d2d299e6d4e43bcf533d93ad07b3f2663918201f3bef3e90620bdec3fccafca7"
    },
    {
      "id": "fixture-033",
      "text": "The tablet and phone should show the same saved preferences after syncing.",
      "webm": "033.webm",
      "webm_bytes": 16812,
      "webm_sha256": "cff9520d0af5553cb05f12cdd2f539ba70fcb02638cb0e5872e292997de460f7"
    },
    {
      "id": "fixture-034",
      "text": "I would rather see one useful error than several confusing warnings.",
      "webm": "034.webm",
      "webm_bytes": 15238,
      "webm_sha256": "fd1811d31cc791a5a4c51b745091e7ceef31f74b886a5743d0c6d481fc1be2ed"
    },
    {
      "id": "fixture-035",
      "text": "Please leave unrelated changes untouched while you update the provider adapter.",
      "webm": "035.webm",
      "webm_bytes": 17823,
      "webm_sha256": "4cacb48d53fea905510639b3354f266bfbf96586920404fa79ae73a95e04fd21"
    },
    {
      "id": "fixture-036",
      "text": "The test should fail first so that the new behavior is genuinely protected.",
      "webm": "036.webm",
      "webm_bytes": 17180,
      "webm_sha256": "106d3eab2612d72f81ddeeb668ba18c316af40cdd498c42edb5f46df97830c9b"
    },
    {
      "id": "fixture-037",
      "text": "Can you measure the disk usage before and after the cleanup?",
      "webm": "037.webm",
      "webm_bytes": 13314,
      "webm_sha256": "3f66d65e7c5553d8d656e3c14cabab0a1e643dbe55f1b906078f0311d92ecdb8"
    },
    {
      "id": "fixture-038",
      "text": "The green status indicator means the service is ready for a real request.",
      "webm": "038.webm",
      "webm_bytes": 16932,
      "webm_sha256": "c0047bd1f212b0d63e465fa863faeb7fbd7db0ab731e69443ec9dd88f5e71391"
    },
    {
      "id": "fixture-039",
      "text": "I want the application to work even when the terminal is temporarily hidden.",
      "webm": "039.webm",
      "webm_bytes": 16968,
      "webm_sha256": "56b628819012039dd68006a02ff6b025296c87c2099de7b1ddcdbe416615c1fd"
    },
    {
      "id": "fixture-040",
      "text": "The remote session belongs to tmux, not to the lifetime of this connection.",
      "webm": "040.webm",
      "webm_bytes": 17521,
      "webm_sha256": "6c4c40ec828c13b7eda80667e2c725af882b338de1ad108bc32d4d1f5aed31fa"
    },
    {
      "id": "fixture-041",
      "text": "Please confirm that the credentials never appear in logs or screenshots.",
      "webm": "041.webm",
      "webm_bytes": 16267,
      "webm_sha256": "2603141019f45b19db76dd6b4c052521622e5441c50bfb1ec2e84c941d13ad82"
    },
    {
      "id": "fixture-042",
      "text": "Which capability was observed most recently by the headed browser?",
      "webm": "042.webm",
      "webm_bytes": 15510,
      "webm_sha256": "4a48cc5726f88c4982f99d003ad760fd290e5db6e357fe0652daf641841f5d69"
    },
    {
      "id": "fixture-043",
      "text": "The audio file is short enough to fit within the bounded request limit.",
      "webm": "043.webm",
      "webm_bytes": 15436,
      "webm_sha256": "e29cb6e107295550d1d05d3587c5f6face945825ce4c0abcf0591640641f0a36"
    },
    {
      "id": "fixture-044",
      "text": "I use the question mark often, so it should not be buried in a group.",
      "webm": "044.webm",
      "webm_bytes": 16781,
      "webm_sha256": "9bad70e273e22a145e7725c07cdf63025f529beb90e1a7110e8830d8021d2b5b"
    },
    {
      "id": "fixture-045",
      "text": "The new screen needs a clear title, a single primary action, and useful empty state.",
      "webm": "045.webm",
      "webm_bytes": 21099,
      "webm_sha256": "da2d60df1f74d59f1999ccb1fcfd67ddf28d8435d2a058ddf884897b9f9231b1"
    },
    {
      "id": "fixture-046",
      "text": "Could you retry only the failed provider while leaving the healthy one alone?",
      "webm": "046.webm",
      "webm_bytes": 15948,
      "webm_sha256": "00f8dc329979513b618d09b2749093290316fd2f756e8d12d27df1186e1f4657"
    },
    {
      "id": "fixture-047",
      "text": "The server is reachable from home, but the laptop address changes outside.",
      "webm": "047.webm",
      "webm_bytes": 17871,
      "webm_sha256": "ceb8c639155fd74139ca7a3b6c24f2016bf945d443db73d4c7f491a4253c0d57"
    },
    {
      "id": "fixture-048",
      "text": "Please make the default behavior safe for unattended background operation.",
      "webm": "048.webm",
      "webm_bytes": 17671,
      "webm_sha256": "d627d60d5d62b3690ef0f8b6df00b0fde3a2ad57049448d70aa76f9a6571f596"
    },
    {
      "id": "fixture-049",
      "text": "The release build passed locally before it was copied to the test device.",
      "webm": "049.webm",
      "webm_bytes": 16723,
      "webm_sha256": "a9522a25004da9f6a4fb3d2f49b5d106c5750b8c3faea48d8869df431c980a3b"
    },
    {
      "id": "fixture-050",
      "text": "I want to understand the tradeoff before we add another dependency.",
      "webm": "050.webm",
      "webm_bytes": 15771,
      "webm_sha256": "ad9b18148cd549b2f892d7246de43aa45fdc939561910f04c8ff719a9b2e80d8"
    },
    {
      "id": "fixture-051",
      "text": "The authentication session is valid, but the capability evidence is outdated.",
      "webm": "051.webm",
      "webm_bytes": 18671,
      "webm_sha256": "3f0aa391fb9722c9199862077411f4b2c703acaa92b42a016492f4b06a89ae8c"
    },
    {
      "id": "fixture-052",
      "text": "Can the service refresh both pieces of evidence without opening a browser per request?",
      "webm": "052.webm",
      "webm_bytes": 19870,
      "webm_sha256": "b79da61e217aed82b8d3a2801d3709fb8ea014db3965263f1adbbb469c333a70"
    },
    {
      "id": "fixture-053",
      "text": "The response should include a stable provider-neutral schema for the client.",
      "webm": "053.webm",
      "webm_bytes": 15943,
      "webm_sha256": "a50e5ecc9bc718d1083e0f5576821be10355b533632f0374c40a1977154681dc"
    },
    {
      "id": "fixture-054",
      "text": "Please keep the retry budget small enough to protect battery and bandwidth.",
      "webm": "054.webm",
      "webm_bytes": 17008,
      "webm_sha256": "b18b8389b5176509aa0f3fd327190d52fd86354a627a304067c41100db4bdb73"
    },
    {
      "id": "fixture-055",
      "text": "The first sentence is a statement, and the next one asks a question.",
      "webm": "055.webm",
      "webm_bytes": 16033,
      "webm_sha256": "eec02030b727b25a3728c69a164a5e2dc67126a663523c2cead42455db8283f3"
    },
    {
      "id": "fixture-056",
      "text": "I would like one fixture with a comma, a dash, and a colon.",
      "webm": "056.webm",
      "webm_bytes": 14881,
      "webm_sha256": "d1c5bfb66ff299afe00de5c92f278aeae5be5663ba7cca31ca38f6998a6cde29"
    },
    {
      "id": "fixture-057",
      "text": "The number forty two should remain understandable when spoken aloud.",
      "webm": "057.webm",
      "webm_bytes": 14948,
      "webm_sha256": "ef2412b2644101b526786c00e4ab2df3aa333843e1b31b24a41a6586aad828df"
    },
    {
      "id": "fixture-058",
      "text": "Please check whether the WebM file has a valid container header.",
      "webm": "058.webm",
      "webm_bytes": 13721,
      "webm_sha256": "a3c6d695615def737a5c949b6b29c0eb70bb2d9d1de58417cdced337f0fa7220"
    },
    {
      "id": "fixture-059",
      "text": "The WebM file should use a mono sixteen kilohertz Opus stream.",
      "webm": "059.webm",
      "webm_bytes": 15661,
      "webm_sha256": "59d571bf5d3350f4b4c0020aacb7bf18b4be2d666260e05d7c7b4616e1674ebf"
    },
    {
      "id": "fixture-060",
      "text": "Could a capability refresh failure make the provider report not ready?",
      "webm": "060.webm",
      "webm_bytes": 16052,
      "webm_sha256": "bb05a92fe47c38bc143c365adef5ef36dd5d9a5c59728445d45e730fe2caa058"
    },
    {
      "id": "fixture-061",
      "text": "The health check should distinguish missing evidence from expired evidence.",
      "webm": "061.webm",
      "webm_bytes": 15754,
      "webm_sha256": "2bd26cbdecf9e4b553ec9bfc2f868fd49b6f3f140317349fdb7703f38acc8f43"
    },
    {
      "id": "fixture-062",
      "text": "I prefer a direct request when the persisted owner-only template is fresh.",
      "webm": "062.webm",
      "webm_bytes": 17228,
      "webm_sha256": "6f1d7784ef757cb4b237f12a74242d4088be619a35a468a0f9d19455d434a3f4"
    },
    {
      "id": "fixture-063",
      "text": "The headed browser is a repair boundary, not the normal transcription path.",
      "webm": "063.webm",
      "webm_bytes": 17507,
      "webm_sha256": "8d86e3c8037bd5e3f03d29645c951f5fcbefe46f3e45c192e547784ab357561c"
    },
    {
      "id": "fixture-064",
      "text": "Please use a random-looking sentence only as ordinary synthetic test data.",
      "webm": "064.webm",
      "webm_bytes": 17422,
      "webm_sha256": "87a45f249030b4e628f4769a00438c2cd2dc3532c45f3075f688dd5bc22c32de"
    },
    {
      "id": "fixture-065",
      "text": "We should never generate traffic merely to avoid a provider detection system.",
      "webm": "065.webm",
      "webm_bytes": 18302,
      "webm_sha256": "6a96deea3bbe8db6d5ebb9ce6c92a6de5461b2aca544971ec34abbaf926248a6"
    },
    {
      "id": "fixture-066",
      "text": "The fixture generator runs once during development and never from a scheduler.",
      "webm": "066.webm",
      "webm_bytes": 17380,
      "webm_sha256": "ad0a89e1fe771f6d1253b0eb1a461286bde3719d3d27707ec034917694799f04"
    },
    {
      "id": "fixture-067",
      "text": "Can the same contract be exercised on an Apple laptop and Ubuntu server?",
      "webm": "067.webm",
      "webm_bytes": 17785,
      "webm_sha256": "8f85ab182e5ffa5a1ca207c9860e45a6a3f90e1039af967385839a27445a648a"
    },
    {
      "id": "fixture-068",
      "text": "The service should identify its build without revealing private configuration.",
      "webm": "068.webm",
      "webm_bytes": 17931,
      "webm_sha256": "1ce377ce5a7956cce0d47dbdfa899eff6cb24703d6fc4fa8c32bb42e36f702ec"
    },
    {
      "id": "fixture-069",
      "text": "I want the command to return a useful exit status when a dependency is absent.",
      "webm": "069.webm",
      "webm_bytes": 18952,
      "webm_sha256": "bb62e94507e8a12ac60696a457af393c0ed08cd094d1b25985eb2d7a50f423dd"
    },
    {
      "id": "fixture-070",
      "text": "The background coordinator needs one schedule instead of one timer per provider.",
      "webm": "070.webm",
      "webm_bytes": 17947,
      "webm_sha256": "1de7840ba9dac1606cc5de29cfadba192d26baf8ab955c43853683fd7a42dacd"
    },
    {
      "id": "fixture-071",
